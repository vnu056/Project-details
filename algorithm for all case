
%%%%Full Code for Hybrid GA-PSO Main Script matlab Copy code%%%%%%%%%%%%%%
clc;
clear;
close all;

%% Hybrid GA-PSO Optimization
% Define the bounds for the variables
lb = [2, 19, 3, 8, 26, 3, 150, 150, 150, 150];  % Lower bounds
ub = [2, 19, 7, 25, 30, 12, 1200, 1200, 1200, 1200];  % Upper bounds

% Objective function (example: Sphere function)
objectiveFunction = @(x) sum(x.^2); % Replace with your actual objective function

% Number of variables
numVars = length(lb);

%% Step 1: Genetic Algorithm (GA) Phase
disp('Starting Genetic Algorithm...');
% GA Parameters
PopulationSize = 100;
MaxGenerations = 50;
Pm = 0.1; % Mutation probability
etam = 20; % Mutation distribution index

% Initialize population
population = rand(PopulationSize, numVars) .* (ub - lb) + lb;

% Start GA loop
for gen = 1:MaxGenerations
    % Evaluate fitness
    fitnessValues = arrayfun(objectiveFunction, population);

    % Tournament Selection
    MatingPoolIndices = TournamentSelection(fitnessValues, PopulationSize);
    SelectedIndividuals = population(MatingPoolIndices, :);

    % Crossover (single-point crossover)
    offspring = Crossover(SelectedIndividuals);

    % Mutation (polynomial mutation)
    offspring = MutationPoly(offspring, Pm, etam, lb, ub);

    % Replace population with offspring
    population = offspring;

    % Log best solution of this generation
    [bestFitness, bestIdx] = min(fitnessValues);
    bestSolutionGA = population(bestIdx, :);
    disp(['Generation ', num2str(gen), ': Best Fitness = ', num2str(bestFitness)]);
end
disp('GA Phase Completed');
disp(['GA Solution: ', num2str(bestSolutionGA)]);
disp(['GA Objective Value: ', num2str(bestFitness)]);

%% Step 2: Particle Swarm Optimization (PSO) Phase
disp('Starting Particle Swarm Optimization...');
% PSO Parameters
SwarmSize = 100;
MaxIterations = 100;

% Use GA solution as initial swarm
initialSwarm = repmat(bestSolutionGA, SwarmSize, 1) + randn(SwarmSize, numVars) .* 0.1;

% PSO Optimization
optionsPSO = optimoptions('particleswarm', ...
    'SwarmSize', SwarmSize, ...
    'MaxIterations', MaxIterations, ...
    'InitialSwarmMatrix', initialSwarm, ...
    'Display', 'iter');

% Run PSO
[hybridSolution, hybridFitness] = particleswarm(objectiveFunction, numVars, lb, ub, optionsPSO);

disp('PSO Phase Completed');
disp(['Hybrid Solution: ', num2str(hybridSolution)]);
disp(['Hybrid Objective Value: ', num2str(hybridFitness)]);

%% Results
disp('Final Optimization Results:');
disp(['Optimal Solution: ', num2str(hybridSolution)]);
disp(['Objective Function Value: ', num2str(hybridFitness)]);

%%%%%%%%%%%%% Polynomial Mutation (MutationPoly.m) matlab Copy code
function offspring = MutationPoly(offspring, Pm, etam, lb, ub)
    [Np, D] = size(offspring); % Population size and number of variables

    for i = 1:Np
        r = rand;
        if r < Pm % Mutation probability check
            for j = 1:D
                r = rand;
                if r < 0.5
                    delta = (2 * r)^(1 / (etam + 1)) - 1;
                else
                    delta = 1 - (2 * (1 - r))^(1 / (etam + 1));
                end
                offspring(i, j) = offspring(i, j) + (ub(j) - lb(j)) * delta;
            end
            % Bound the mutated offspring
            offspring(i, :) = max(offspring(i, :), lb);
            offspring(i, :) = min(offspring(i, :), ub);
        end
    end
end
%%%%%%%%%%%%%%%%%%%% Tournament Selection (TournamentSelection.m) matlab Copy code
function MatingPool = TournamentSelection(f, Np)
    MatingPool = NaN(Np, 1);
    indx = randperm(Np); % Shuffle indices

    for i = 1:Np - 1
        Candidate = [indx(i), indx(i + 1)];
        CandidateObj = f(Candidate);
        [~, ind] = min(CandidateObj);
        MatingPool(i) = Candidate(ind);
    end

    Candidate = [indx(Np), indx(1)];
    CandidateObj = f(Candidate);
    [~, ind] = min(CandidateObj);
    MatingPool(Np) = Candidate(ind);
end
%%%%%%%%%%%%%%%%%Crossover Function (Crossover.m) matlab Copy code
function offspring = Crossover(parents)
    [Np, D] = size(parents); % Number of parents and variables
    offspring = NaN(Np, D);

    for i = 1:2:Np - 1
        p1 = parents(i, :);
        p2 = parents(i + 1, :);
        crossoverPoint = randi([1, D - 1]);
        offspring(i, :) = [p1(1:crossoverPoint), p2(crossoverPoint + 1:end)];
        offspring(i + 1, :) = [p2(1:crossoverPoint), p1(crossoverPoint + 1:end)];
    end

    if mod(Np, 2) == 1 % If odd number of parents
        offspring(Np, :) = parents(Np, :);
    end
end
