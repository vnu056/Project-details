clc;
clear;
close all;

%% Hybrid GA-PSO Optimization
% Define the bounds for the variables
lb = [2, 19, 3, 8, 26, 3, 150, 150, 150, 150];  %% Lower bounds of variables
ub = [2, 19, 7, 25, 30, 12, 1200, 1200, 1200, 1200];  %% Upper bounds of variables

% Objective function (example: Sphere function)
objectiveFunction = @(x) sum(x.^2); % Replace this with your own objective function

% Number of variables
numVars = length(lb);

%% Step 1: Genetic Algorithm (GA) Phase
% Set GA options
optionsGA = optimoptions('ga', ...
    'PopulationSize', 100, ...
    'MaxGenerations', 50, ...
    'InitialPopulationRange', [lb; ub], ...
    'Display', 'iter');

% Run GA
disp('Starting Genetic Algorithm...');
[gaSolution, gaFitness] = ga(objectiveFunction, numVars, [], [], [], [], lb, ub, [], optionsGA);
disp('GA Phase Completed');
disp(['GA Solution: ', num2str(gaSolution)]);
disp(['GA Objective Value: ', num2str(gaFitness)]);

%% Step 2: Particle Swarm Optimization (PSO) Phase
% Set PSO options
optionsPSO = optimoptions('particleswarm', ...
    'SwarmSize', 100, ...
    'MaxIterations', 100, ...
    'Display', 'iter');

% Run PSO using GA's solution as a starting point
disp('Starting Particle Swarm Optimization...');
[hybridSolution, hybridFitness] = particleswarm(objectiveFunction, numVars, lb, ub, optionsPSO);
disp('PSO Phase Completed');
disp(['PSO Solution: ', num2str(hybridSolution)]);
disp(['PSO Objective Value: ', num2str(hybridFitness)]);

%% Results
disp('Final Optimization Results:');
disp(['Optimal Solution: ', num2str(hybridSolution)]);
disp(['Objective Function Value: ', num2str(hybridFitness)]);

%% Plot Convergence (Optional)
% If you want to plot convergence from GA and PSO phases:
figure;
hold on;
title('Convergence of Hybrid GA-PSO');
xlabel('Iteration');
ylabel('Objective Value');
legend('GA', 'PSO');
grid on;
